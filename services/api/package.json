{
  "name": "@peloton/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "node --experimental-strip-types src/seed.ts",
    "contract:check": "node --experimental-strip-types scripts/contract-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.0",
    "pg": "8.16.3",
    "yaml": "2.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.4",
    "tsx": "4.20.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
